# Copy to .env (local) and add the SAME keys in Vercel > Settings > Environment Variables
# Local development: copy this file to .env and use a Google App Password
# (not your regular Gmail password). Keep .env private and uncommitted.
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_google_app_password
OWNER_EMAIL=your_gmail_address@gmail.com
